# Set to 'true' to run frontend standalone with mock data (no backend API required)
# Set to 'false' to connect to the backend REST API at http://127.0.0.1:8000
VITE_DEBUG=true
DEBUG=true

# Backend URL. Dev: target of the Vite proxy (default http://127.0.0.1:8000). Prod build: base for API calls.
VITE_API_URL=http://127.0.0.1:8000
